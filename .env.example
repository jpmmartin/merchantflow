# Copy to `.env` at the repository root to override a default. Every variable
# below is optional in development except DATABASE_URL, which has no default;
# the values shown for the others are their defaults. Real environment variables
# take precedence over this file. Never commit a `.env`.

# Runtime mode: development | test | production.
NODE_ENV=development

# Minimum level written to the structured JSON logs: fatal | error | warn |
# info | debug | trace | silent.
LOG_LEVEL=info

# Interface the API binds to (an IPv4 or IPv6 address). The default keeps the
# server private to the machine. Compose sets 0.0.0.0 for the `dev` container,
# because a published port cannot reach a server bound to the container's
# loopback. Use 0.0.0.0 or a private address only when something else (a load
# balancer, a reverse proxy on another host) must reach the API directly.
HOST=127.0.0.1

# TCP port the API listens on inside the container (1-65535). Compose publishes
# it on 127.0.0.1:3000 of the host.
PORT=3000

# PostgreSQL connection URI (postgres:// or postgresql://), required. It carries
# the database password, so it has no default and is never logged. Compose sets
# it for the `dev` service from POSTGRES_PASSWORD, pointing at the `postgres`
# service, so it needs setting by hand only outside Compose. Percent-encode
# reserved characters in the user name and the password.
DATABASE_URL=postgresql://merchantflow:change-me@postgres:5432/merchantflow

# Comma-separated browser origins allowed to call the API through CORS, each
# scheme://host[:port] with no path and no wildcard. Unset, development and test
# allow the Vite server of apps/web (the list below) and production allows none.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email of the platform administrator user that `pnpm db:seed` creates. Its
# password is generated and printed once; it is never configured here.
SEED_ADMIN_EMAIL=admin@merchantflow.test

# Base URL of the API that the web frontend (apps/web) calls from the browser.
# Read by Vite, which exposes only VITE_-prefixed variables to the browser.
VITE_API_BASE_URL=http://localhost:3000/api/v1
