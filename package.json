{
  "name": "merchantflow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": "12.16.1"
  },
  "scripts": {
    "dev": "pnpm --filter @merchantflow/database build && pnpm --filter @merchantflow/api dev",
    "build": "pnpm -r --if-present build",
    "db:migrate": "pnpm build && pnpm --filter @merchantflow/api db:migrate",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm -r --if-present test:integration",
    "lint": "eslint .",
    "format": "prettier --write --no-error-on-unmatched-pattern \"apps/**/*.{ts,json}\" \"packages/**/*.{ts,json}\" \"*.{mjs,json,yml}\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"apps/**/*.{ts,json}\" \"packages/**/*.{ts,json}\" \"*.{mjs,json,yml}\"",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
